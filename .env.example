APP_NAME="မောင်းဘုရင်"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=
APP_TIMEZONE=Asia/Yangon

# Required when running `php artisan db:seed` in production.
LUCKYDRAW_ADMIN_EMAIL=
LUCKYDRAW_ADMIN_PASSWORD=
LUCKYDRAW_ADMIN_NAME="မောင်းဘုရင် Admin"
LUCKYDRAW_SEED_SAMPLE_USER=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Phase 4 operations/observability
PHASE4_HEALTH_RECENT_SPIN_WINDOW_MINUTES=15
PHASE4_HEALTH_SUSPICIOUS_MINUTE_THRESHOLD=12
PHASE4_HEALTH_REQUIRE_JOB_TABLE=true
PHASE4_BACKUP_RETENTION_DAYS=30
OPS_BACKUP_DIR=ops/backups
DEPLOY_BRANCH=main

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push notifications. Generate once with: php artisan webpush:vapid
WEBPUSH_VAPID_SUBJECT=mailto:admin@mbyfootball.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
